# Lidiya model provider references only. Do not place real secrets in this file.

# Online Lidiya brain
LIDIYA_OPENAI_ENABLED=0
LIDIYA_OPENAI_MODEL=
LIDIYA_OPENAI_API_KEY_ENV=OPENAI_API_KEY

# Gemini coding/tool worker
LIDIYA_GEMINI_ENABLED=0
LIDIYA_GEMINI_MODEL=
LIDIYA_GEMINI_API_KEY_ENV=GEMINI_API_KEY

# Local Ollama body
LIDIYA_OLLAMA_ENABLED=1
LIDIYA_OLLAMA_BASE_URL=http://127.0.0.1:11434
LIDIYA_OLLAMA_ROUTER_MODEL=
LIDIYA_OLLAMA_WORKER_MODEL=

# Local body bridge: localhost only. The real token must exist only in the local
# environment or OS secret manager and must never be committed or pasted in chat.
LIDIYA_BRIDGE_HOST=127.0.0.1
LIDIYA_BRIDGE_PORT=8765
LIDIYA_BRIDGE_TOKEN_ENV=LIDIYA_BRIDGE_TOKEN

# No provider may automatically download/update a model or change paid quota.
LIDIYA_ALLOW_MODEL_DOWNLOAD=0
LIDIYA_ALLOW_PROVIDER_QUOTA_CHANGE=0
LIDIYA_ALLOW_CREDENTIAL_EXPORT=0
