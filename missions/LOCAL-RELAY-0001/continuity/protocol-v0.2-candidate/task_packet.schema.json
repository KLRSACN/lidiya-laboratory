{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"task_packet.schema.json","type":"object","additionalProperties":false,"required":["mission_id","token","task_id","target_worker","action","objective","created_at","attempt","max_attempts","lease_seconds","payload","success_criteria","evidence_required"],"properties":{"mission_id":{"$ref":"#/$defs/id"},"token":{"$ref":"#/$defs/id"},"task_id":{"$ref":"#/$defs/id"},"target_worker":{"type":"string","pattern":"^(?:WINDOW-[0-9]{2}|ANY)$"},"action":{"enum":["WRITE_TEXT","RETRY","RECOVER","CANCEL"]},"objective":{"type":"string","minLength":1,"pattern":".*\\S.*"},"created_at":{"type":"string","format":"date-time","pattern":"Z$"},"attempt":{"type":"integer","minimum":0},"max_attempts":{"type":"integer","minimum":1,"maximum":100},"lease_seconds":{"type":"integer","minimum":5,"maximum":3600},"payload":{"type":"object","additionalProperties":true},"success_criteria":{"$ref":"#/$defs/nonempty_list"},"evidence_required":{"$ref":"#/$defs/nonempty_list"}},"$defs":{"id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},"nonempty_list":{"type":"array","minItems":1,"items":{"type":"string","minLength":1,"pattern":".*\\S.*"}}},"x-invariants":["attempt <= max_attempts","runtime fields are forbidden in task packet"]}
