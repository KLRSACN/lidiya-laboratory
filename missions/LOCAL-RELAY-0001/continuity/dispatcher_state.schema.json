{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"dispatcher_state.schema.json","title":"Dispatcher Persistent State v0.1","type":"object","additionalProperties":false,"required":["mission_id","token","generation","updated_at","tasks","completed_index"],"properties":{"mission_id":{"type":"string","minLength":1},"token":{"type":"string","minLength":1},"generation":{"type":"integer","minimum":1},"updated_at":{"type":"string","format":"date-time"},"tasks":{"type":"object","additionalProperties":{"type":"object","additionalProperties":false,"required":["state","attempt","max_attempts","lease_generation","recovery_count"],"properties":{"state":{"enum":["RECEIVED","VALIDATED","CLAIMED","RUNNING","COMPLETED","RETRY_PENDING","FAILED","QUARANTINED","RECOVERY_PENDING"]},"attempt":{"type":"integer","minimum":0},"max_attempts":{"type":"integer","minimum":1},"lease_generation":{"type":"integer","minimum":0},"recovery_count":{"type":"integer","minimum":0},"claim_id":{"type":["string","null"]},"last_error":{"type":["string","null"]}}}},"completed_index":{"type":"object","additionalProperties":{"type":"object","additionalProperties":false,"required":["status","result_hash","completed_at","worker_id","attempt","outbox_path"],"properties":{"status":{"enum":["COMPLETED","FAILED","QUARANTINED"]},"result_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"completed_at":{"type":"string","format":"date-time"},"worker_id":{"type":"string","minLength":1},"attempt":{"type":"integer","minimum":0},"outbox_path":{"$ref":"#/$defs/safe_relative_path"}}}}},"$defs":{"safe_relative_path":{"type":"string","minLength":1,"maxLength":512,"allOf":[{"not":{"pattern":"(^|[\\\\/])\\.\\.([\\\\/]|$)"}},{"not":{"pattern":"^(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\)"}},{"pattern":"^[A-Za-z0-9._/\\\\-]+$"}]}}}
