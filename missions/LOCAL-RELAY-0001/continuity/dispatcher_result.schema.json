{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"dispatcher_result.schema.json","title":"Dispatcher Result v0.1","type":"object","additionalProperties":false,"required":["mission_id","token","task_id","unique_key","status","worker_id","attempt","completed_at","result_hash","outbox_path","claim_id","lease_generation","evidence"],"properties":{"mission_id":{"type":"string","minLength":1},"token":{"type":"string","minLength":1},"task_id":{"type":"string","minLength":1},"unique_key":{"type":"string","pattern":"^[^:]+::[^:]+::[^:]+$"},"status":{"enum":["COMPLETED","FAILED","QUARANTINED"]},"worker_id":{"type":"string","minLength":1},"attempt":{"type":"integer","minimum":0},"completed_at":{"type":"string","format":"date-time"},"result_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"outbox_path":{"$ref":"#/$defs/safe_relative_path"},"claim_id":{"type":"string","minLength":1},"lease_generation":{"type":"integer","minimum":0},"evidence":{"type":"array","items":{"type":"string","minLength":1}}},"$defs":{"safe_relative_path":{"type":"string","minLength":1,"maxLength":512,"allOf":[{"not":{"pattern":"(^|[\\\\/])\\.\\.([\\\\/]|$)"}},{"not":{"pattern":"^(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\)"}},{"pattern":"^[A-Za-z0-9._/\\\\-]+$"}]}}}
